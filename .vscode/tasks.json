{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Install Dependencies",
      "type": "shell",
      "command": "pip install -r backend/requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "2. Seed Data",
      "type": "shell",
      "command": "python scripts/seed_data.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/backend" }
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "3. Start Backend",
      "type": "shell",
      "command": "uvicorn main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "new" },
      "isBackground": true
    },
    {
      "label": "4. Open Frontend",
      "type": "shell",
      "command": "python -m http.server 3000 --directory frontend",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "new" }
    }
  ]
}
